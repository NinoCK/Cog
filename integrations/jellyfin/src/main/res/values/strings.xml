<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="jf_name">Jellyfin</string>
    <string name="jf_description">Play movies, shows and music from your Jellyfin server, and control them by voice.</string>
    <string name="jf_summary_set_up">Signed in as %1$s</string>
    <string name="jf_summary_not_set_up">Not set up</string>
    <string name="jf_card_not_set_up">Jellyfin isn\'t set up</string>

    <!-- Settings -->
    <string name="jf_intro">Cog signs in to your Jellyfin server as you, finds what you ask for in your library and plays it on a Jellyfin player you have open: the TV app, a browser, Kodi. Nothing goes through anyone else\'s server.</string>
    <string name="jf_url">Server address</string>
    <string name="jf_url_hint">http://192.168.1.10:8096</string>
    <string name="jf_user">User name</string>
    <string name="jf_password">Password</string>
    <string name="jf_test">Sign in</string>
    <string name="jf_status_checking">Signing in…</string>
    <string name="jf_status_not_set">Enter your server\'s address and your user name, then sign in.</string>
    <string name="jf_status_ok">Signed in as %1$s.</string>
    <plurals name="jf_status_titles">
        <item quantity="one">%d movie or show in your library.</item>
        <item quantity="other">%d movies and shows in your library.</item>
    </plurals>
    <string name="jf_status_no_players">No player is open right now: open Jellyfin on your TV to play on it.</string>
    <string name="jf_status_players">Players open now: %1$s.</string>
    <string name="jf_players">Players</string>
    <string name="jf_players_note">Say where to play (“on the bedroom TV”) or Cog plays on the player already playing, the only one open, or the one named here.</string>
    <string name="jf_default_player">Usual player</string>
    <string name="jf_default_player_hint">Living Room TV</string>
    <string name="jf_phone_note">Say “on my phone” to watch here: in Jellyfin, if it\'s open on this phone, otherwise in a video player.</string>
    <string name="jf_examples">What to say</string>
    <string name="jf_examples_text">“Play Inception” · “Watch Breaking Bad” · “Play season 2 episode 3 of The Office on the bedroom TV” · “Play the next episode” · “Continue watching” · “Put on a random comedy” · “Pause the movie” · “Skip ahead 30 seconds” · “Go back 10 seconds” · “Jump to 1 hour 20 minutes” · “Turn on Greek subtitles” · “Switch the audio to English” · “Set the Jellyfin volume to 30” · “What am I watching?” · “How much is left?” · “What’s new on Jellyfin?” · “What should I watch?” · “Mark this as watched” · “Play Abbey Road on Jellyfin”</string>

