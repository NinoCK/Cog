<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- DuckDuckGo suggestions and instant answers; Open-Meteo weather -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional, requested at runtime: contact search, "call mom" -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- "Uninstall" in an app result's long-press menu -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- "alarm 7am", "timer 5 min": required by AlarmClock.ACTION_SET_ALARM / ACTION_SET_TIMER (install-time) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Optional, requested at runtime: local weather. Coordinates sent for weather are rounded to ~1 km. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Optional, requested the first time it's needed: "remember where I parked", "send alex my location" -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- "Remind me at 5": reminders go off on time (exact alarms; granted by default on Android 12) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Requested at runtime: listening when the overlay opens, and the offline wake word -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The wake word runs as a microphone foreground service with an ongoing notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- User-granted: lets the wake word open the assistant while another app is in front -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- After a restart, a one-tap reminder to resume the wake word -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional, requested in settings: "run the task called ..." starts the user's Tasker task -->
    <uses-permission android:name="net.dinglisch.android.tasker.PERMISSION_RUN_TASKS" />

    <!-- The torch works without the camera; don't hide the app from devices without one. -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Package visibility (Android 11+): what the overlay needs to see and resolve. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- In-app speech recognition (no popup) and text-to-speech engines -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- "play iron maiden": find which music apps are installed -->
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="deezer.android.app" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.soundcloud.android" />
        <package android:name="com.aspiro.tidal" />
        <package android:name="com.amazon.mp3" />
        <!-- "take me home": the navigation apps, and Tasker for "run the task ..." -->
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
        <package android:name="net.dinglisch.android.taskerm" />
        <package android:name="net.dinglisch.android.tasker" />
    </queries>

    <application
        android:name=".FastSearchApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.FastSearch"
        tools:targetApi="36">

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "App settings" link from the system's app info / default-apps screens -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            The assistant overlay. Declaring ACTION_ASSIST is what lists FastSearch under
            Settings > Apps > Default apps > Digital assistant app; once selected, the system
            starts this activity for the assistant gesture.
        -->
        <activity
            android:name=".assist.AssistActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/assist_label"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.FastSearch.Overlay"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.fastsearch.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- "FastSearch" in the text-selection toolbar -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Offline wake word ("ok Cog"): listens on the phone, opens the overlay when heard -->
        <service
            android:name="com.bestassistant.wake.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name="com.bestassistant.wake.WakeRestartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Reminders: the alarm going off, the notification's Done / Snooze, and setting them again after a restart -->
        <receiver
            android:name="com.bestassistant.reminders.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Media control: Android grants access to other apps' media sessions (Spotify's "play from
            search", like, shuffle) through notification access. Notifications themselves are ignored.
        -->
        <service
            android:name="com.bestassistant.media.MediaListener"
            android:exported="true"
            android:label="@string/step_media_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Optional, user-enabled: taps Spotify's play button once after "play ..." (Spotify opens
            pages for other apps but won't start them). Limited to Spotify's windows.
        -->
        <service
            android:name="com.bestassistant.media.SpotifyPlayService"
            android:exported="true"
            android:label="@string/press_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/spotify_press_service" />
        </service>

        <service
            android:name=".tile.SearchTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_search"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
