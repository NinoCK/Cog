    <!-- Optional accessibility helper that presses play in Spotify -->
    <string name="press_service_label">Cog: press play in Spotify</string>
    <string name="press_service_description">After you ask Cog to play an artist, album, song or playlist on Spotify, this taps the play button on the page Spotify opens, once. It only acts in Spotify, only for a few seconds after you ask, and reads nothing else.</string>
    <string name="step_press_title">Press play in Spotify</string>
    <string name="step_press_body">Spotify opens what you ask for but won\'t start it for other apps. This lets Cog tap its play button once, right after you ask; it only works inside Spotify. In the list, pick “Cog: press play in Spotify”. If the switch is greyed out: App info › ⋮ › Allow restricted settings.</string>

    <!-- Spotify connection (the user's own Client ID) -->
    <string name="section_spotify">Spotify connection</string>
    <string name="spotify_connect_intro">Optional. With your own Spotify Client ID, Cog starts the music in Spotify by itself, through Spotify\'s official connection. Registering is free, but Spotify requires the account that registers to have Premium.</string>
    <string name="spotify_step1">1. Open the Spotify developer dashboard, log in, and create an app. Under “Which API/SDKs are you planning to use?”, tick Android.</string>
    <string name="spotify_open_dashboard">Open the dashboard</string>
    <string name="spotify_step2">2. Add the redirect URI below under Redirect URIs, and the package name and SHA1 fingerprint under Android packages.</string>
    <string name="spotify_step3">3. Copy your app\'s Client ID from the dashboard into the field below, tap Connect and allow Cog in Spotify.</string>
